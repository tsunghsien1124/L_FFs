scf.data <- df.imp
rm(imp1, imp2, imp3, imp4, imp5, rw, df.imp)
gc()
scf.data <- scf.data[(20<=scf.data$age) & (scf.data$age<=60),]
# liquid assets ----------------------------------------------------------------
# checking accounts (CA)
scf.data$CA <- scf.data$x3506 + scf.data$x3510 + scf.data$x3514 + scf.data$x3518 + scf.data$x3522 + scf.data$x3526 + scf.data$x3529
# certificates of deposit (COD)
scf.data$COD <- scf.data$x3721
# savings and money market accounts (SMMA)
scf.data$SMMA <- scf.data$x3736 + scf.data$x3742 + scf.data$x3748 + scf.data$x3754 + scf.data$x3760
# mutual funds (MF)
scf.data$MF <- scf.data$x3822 + scf.data$x3824 + scf.data$x3826 + scf.data$x3828 + scf.data$x3830
# savings bonds (SB)
scf.data$SB <- scf.data$x3902
# other bonds (OB)
scf.data$OB <- scf.data$x3906 + scf.data$x3908 + scf.data$x3910 + scf.data$x7633 + scf.data$x7634
# public stock (PS)
scf.data$PS <- scf.data$x3915
# total liquid assets (TLA)
scf.data$TLA <- scf.data$CA + scf.data$COD + scf.data$SMMA + scf.data$MF + scf.data$SB + scf.data$OB + scf.data$PS
TLA.weighted <- sum(scf.data$TLA * scf.data$wgt)
# credit card borrowing --------------------------------------------------------
scf.data$x413_pos <- as.numeric(scf.data$x413 > 0)
scf.data$x413_debt <- scf.data$x413_pos * scf.data$x413
scf.data$x421_pos <- as.numeric(scf.data$x421 > 0)
scf.data$x421_debt <- scf.data$x421_pos * scf.data$x421
scf.data$x424_pos <- as.numeric(scf.data$x424 > 0)
scf.data$x424_debt <- scf.data$x424_pos * scf.data$x424
scf.data$x427_pos <- as.numeric(scf.data$x427 > 0)
scf.data$x427_debt <- scf.data$x427_pos * scf.data$x427
scf.data$x430_pos <- as.numeric(scf.data$x430 > 0)
scf.data$x430_debt <- scf.data$x430_pos * scf.data$x430
scf.data$x7575_pos <- as.numeric(scf.data$x7575 > 0)
scf.data$x7575_debt <- scf.data$x7575_pos * scf.data$x7575
scf.data$CCD <- scf.data$x413_debt # + scf.data$x421_debt + scf.data$x424_debt + scf.data$x427_debt + scf.data$x430_debt + scf.data$x7575_debt
CCD.weighted <- sum(scf.data$CCD * scf.data$wgt)
# deposit-to-loan ratio --------------------------------------------------------
D2L.ratio <- TLA.weighted / CCD.weighted
share.in.debt <- weighted.mean(scf.data$x413_pos, scf.data$wgt) * 100
# liquid net worth -------------------------------------------------------------
scf.data$nw_liquid <- scf.data$TLA - scf.data$CCD
scf.data$nw_liquid_neg <- as.numeric(scf.data$nw_liquid < 0)
nw_liquid.weighted <- -sum(scf.data$nw_liquid_neg * scf.data$nw_liquid * scf.data$wgt)
share.in.debt.nw_liquid <- weighted.mean(scf.data$nw_liquid_neg, scf.data$wgt) * 100
# net worth --------------------------------------------------------------------
scf.data$networth_neg <- as.numeric(scf.data$networth < 0)
# scf.data$networth_neg <- as.numeric((scf.data$networth < 0) & (scf.data$networth + 1.2 * scf.data$income > 0))
share.in.debt.nw <- weighted.mean(scf.data$networth_neg, scf.data$wgt) * 100
# debt-to-earnings ratio (D2E) [conditional] -----------------------------------
earnings.weighted <- sum(scf.data$wageinc * scf.data$x413_pos * scf.data$wgt)
D2E.ratio <- CCD.weighted / earnings.weighted * 100
earnings.weighted.liquid.weighted <- sum(scf.data$nw_liquid_neg * scf.data$wageinc * scf.data$wgt)
D2E.ratio.nw_liquid <- nw_liquid.weighted / earnings.weighted.liquid.weighted * 100
nw.neg.weighted <- -sum(scf.data$networth_neg * scf.data$networth * scf.data$wgt)
earnings.weighted.nw <- sum(scf.data$networth_neg * scf.data$wageinc * scf.data$wgt)
D2E.ratio.nw <- nw.neg.weighted / earnings.weighted.nw * 100
# D2E.ratio.nw <- nw.neg.weighted / earnings.weighted * 100
# unconditional D2E
un.D2E.ratio <- CCD.weighted / sum(scf.data$wageinc * scf.data$wgt) * 100
un.D2E.ratio.liquid <- nw_liquid.weighted / sum(scf.data$wageinc * scf.data$wgt) * 100
un.D2E.ratio.nw <- nw.neg.weighted / sum(scf.data$wageinc * scf.data$wgt) * 100
# credit card interest rate (CCIR) ---------------------------------------------
scf.data$x7132pos <- as.numeric(scf.data$x7132 > 0)
AvgCCrate <- sum(scf.data$x7132 * scf.data$x7132pos * scf.data$wgt) / sum(scf.data$x7132pos * scf.data$wgt) / 100
AvgCCrate_nw_neg <- sum(scf.data$x7132 * scf.data$x7132pos * scf.data$networth_neg * scf.data$wgt) / sum(scf.data$x7132pos * scf.data$networth_neg * scf.data$wgt) / 100
AvgCCrate_nw_liquid_neg <- sum(scf.data$x7132 * scf.data$x7132pos * scf.data$nw_liquid_neg * scf.data$wgt) / sum(scf.data$x7132pos * scf.data$nw_liquid_neg * scf.data$wgt) / 100
